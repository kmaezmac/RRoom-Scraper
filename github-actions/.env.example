# Copy values to root .env for local runs; use GitHub Secrets in Actions.
RAKUTEN_APP_ID=
ACCESS_TOKEN=
SESSION_ENCRYPTION_KEY=
RAKUTEN_USER_ID=
RAKUTEN_PASSWORD=
RAKUTEN_USER_ID2=
RAKUTEN_PASSWORD2=
RAKUTEN_USER_ID3=
RAKUTEN_PASSWORD3=
# Optional per-account application IDs (fallback to RAKUTEN_APP_ID)
RAKUTEN_APP_ID2=
RAKUTEN_APP_ID3=
# Optional encrypted sessions exported from accountN.bat Chrome
RAKUTEN_SESSION=
RAKUTEN_SESSION2=
RAKUTEN_SESSION3=
OPENAI_API_KEY=
USE_OPENAI=false
RUN_ACCOUNT=all
RUN_MODE=diagnose
MAX_ITEMS=30
