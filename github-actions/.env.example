# Copy values to root .env for local runs; use GitHub Secrets in Actions.
RAKUTEN_APP_ID=
ACCESS_TOKEN=
SESSION_ENCRYPTION_KEY=
RAKUTEN_USER_ID=
RAKUTEN_PASSWORD=
RAKUTEN_USER_ID2=
RAKUTEN_PASSWORD2=
RAKUTEN_USER_ID3=
RAKUTEN_PASSWORD3=
# Optional per-account application IDs (fallback to RAKUTEN_APP_ID)
RAKUTEN_APP_ID2=
RAKUTEN_APP_ID3=
# Optional encrypted sessions exported from accountN.bat Chrome
RAKUTEN_SESSION=
RAKUTEN_SESSION2=
RAKUTEN_SESSION3=
OPENAI_API_KEY=
USE_OPENAI=false
RUN_ACCOUNT=all
RUN_MODE=diagnose
MAX_ITEMS=30
# 新規投稿の上限。未指定ならMAX_ITEMSと同じ。コレ済みは数えません。
MAX_POSTS=30

# Optional Supabase history (fail closed when enabled but unavailable)
HISTORY_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Comma-separated Rakuten genre IDs per account; empty retains legacy filters
ACCOUNT_GENRES1=
ACCOUNT_GENRES2=
ACCOUNT_GENRES3=
# Normal page requests/account/run, with up to 3 attempts/page on temporary errors
RANKING_PAGES_PER_RUN=1
